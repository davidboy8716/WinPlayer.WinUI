<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="WinPlayer.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:WinPlayer.WinUI.Models"
    xmlns:effects="using:WinPlayer.WinUI.Effects"
    Title="私有云播放器 WinUI">

    <Window.SystemBackdrop>
        <MicaBackdrop Kind="BaseAlt" />
    </Window.SystemBackdrop>

    <Grid x:Name="Root" Background="Black" AllowDrop="True"
          DragOver="Root_DragOver" Drop="Root_Drop">
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.ThemeDictionaries>
                    <ResourceDictionary x:Key="Light">
                        <SolidColorBrush x:Key="PlayerChromeTextBrush" Color="#FFFFFFFF" />
                        <SolidColorBrush x:Key="PlayerChromeSecondaryTextBrush" Color="#C8FFFFFF" />
                        <SolidColorBrush x:Key="PlayerChromeTertiaryTextBrush" Color="#88FFFFFF" />
                        <SolidColorBrush x:Key="PlayerChromeStrokeBrush" Color="#38FFFFFF" />
                        <SolidColorBrush x:Key="PlayerChromeButtonBrush" Color="#24FFFFFF" />
                        <SolidColorBrush x:Key="PlayerChromeButtonHoverBrush" Color="#38FFFFFF" />
                        <SolidColorBrush x:Key="PlayerChromeHandleBrush" Color="#E02B3039" />
                        <SolidColorBrush x:Key="PlayerProgressBrush" Color="#FFFFB900" />
                        <SolidColorBrush x:Key="PlayerMarkerBrush" Color="#FF2DA9FF" />
                        <SolidColorBrush x:Key="PlayerPrimaryButtonGlyphBrush" Color="#FF111318" />
                    </ResourceDictionary>
                    <ResourceDictionary x:Key="Dark">
                        <SolidColorBrush x:Key="PlayerChromeTextBrush" Color="#FFFFFFFF" />
                        <SolidColorBrush x:Key="PlayerChromeSecondaryTextBrush" Color="#C8FFFFFF" />
                        <SolidColorBrush x:Key="PlayerChromeTertiaryTextBrush" Color="#88FFFFFF" />
                        <SolidColorBrush x:Key="PlayerChromeStrokeBrush" Color="#38FFFFFF" />
                        <SolidColorBrush x:Key="PlayerChromeButtonBrush" Color="#24FFFFFF" />
                        <SolidColorBrush x:Key="PlayerChromeButtonHoverBrush" Color="#38FFFFFF" />
                        <SolidColorBrush x:Key="PlayerChromeHandleBrush" Color="#E02B3039" />
                        <SolidColorBrush x:Key="PlayerProgressBrush" Color="#FFFFB900" />
                        <SolidColorBrush x:Key="PlayerMarkerBrush" Color="#FF2DA9FF" />
                        <SolidColorBrush x:Key="PlayerPrimaryButtonGlyphBrush" Color="#FF111318" />
                    </ResourceDictionary>
                    <ResourceDictionary x:Key="HighContrast">
                        <StaticResource x:Key="PlayerChromeTextBrush" ResourceKey="SystemColorWindowTextColorBrush" />
                        <StaticResource x:Key="PlayerChromeSecondaryTextBrush" ResourceKey="SystemColorWindowTextColorBrush" />
                        <StaticResource x:Key="PlayerChromeTertiaryTextBrush" ResourceKey="SystemColorGrayTextColorBrush" />
                        <StaticResource x:Key="PlayerChromeStrokeBrush" ResourceKey="SystemColorWindowTextColorBrush" />
                        <StaticResource x:Key="PlayerChromeButtonBrush" ResourceKey="SystemColorButtonFaceColorBrush" />
                        <StaticResource x:Key="PlayerChromeButtonHoverBrush" ResourceKey="SystemColorHighlightColorBrush" />
                        <StaticResource x:Key="PlayerChromeHandleBrush" ResourceKey="SystemColorButtonFaceColorBrush" />
                        <StaticResource x:Key="PlayerProgressBrush" ResourceKey="SystemColorHighlightColorBrush" />
                        <StaticResource x:Key="PlayerMarkerBrush" ResourceKey="SystemColorHotlightColorBrush" />
                        <StaticResource x:Key="PlayerPrimaryButtonGlyphBrush" ResourceKey="SystemColorWindowColorBrush" />
                    </ResourceDictionary>
                </ResourceDictionary.ThemeDictionaries>

                <Style x:Key="PlayerIconButtonStyle" TargetType="Button">
                    <Setter Property="Width" Value="38" />
                    <Setter Property="Height" Value="36" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="CornerRadius" Value="8" />
                    <Setter Property="Background" Value="{ThemeResource PlayerChromeButtonBrush}" />
                    <Setter Property="BorderBrush" Value="{ThemeResource PlayerChromeStrokeBrush}" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="Foreground" Value="{ThemeResource PlayerChromeTextBrush}" />
                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                    <Setter Property="VerticalContentAlignment" Value="Center" />
                </Style>

                <Style x:Key="PlayerToggleButtonStyle" TargetType="ToggleButton">
                    <Setter Property="Width" Value="38" />
                    <Setter Property="Height" Value="36" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="CornerRadius" Value="8" />
                    <Setter Property="Background" Value="{ThemeResource PlayerChromeButtonBrush}" />
                    <Setter Property="BorderBrush" Value="{ThemeResource PlayerChromeStrokeBrush}" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="Foreground" Value="{ThemeResource PlayerChromeTextBrush}" />
                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                    <Setter Property="VerticalContentAlignment" Value="Center" />
                </Style>

                <Style x:Key="SidebarTitleStyle" TargetType="TextBlock">
                    <Setter Property="FontSize" Value="16" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                    <Setter Property="Foreground" Value="{ThemeResource PlayerChromeTextBrush}" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                </Style>
            </ResourceDictionary>
        </Grid.Resources>

        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="WindowWidthStates">
                <VisualState x:Name="CompactWindow">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="AppLogo.Visibility" Value="Collapsed" />
                        <Setter Target="IntroActionButton.Visibility" Value="Collapsed" />
                        <Setter Target="OutroActionButton.Visibility" Value="Collapsed" />
                        <Setter Target="VolumeSlider.Visibility" Value="Collapsed" />
                        <Setter Target="TopTitle.Margin" Value="8,0" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="MediumWindow">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="760" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="VolumeSlider.Visibility" Value="Collapsed" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="WideWindow">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1040" />
                    </VisualState.StateTriggers>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <!-- 隐藏的媒体传输控件；帧服务器输出由 MainWindow 负责绘制。 -->
        <MediaPlayerElement x:Name="PlayerElement" AreTransportControlsEnabled="False" Stretch="Uniform" />

        <Grid Visibility="{x:Bind ViewModel.EmptyStateVisibility, Mode=OneWay}">
            <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                    MinWidth="360" Padding="34,30" CornerRadius="20"
                    Background="#B0181A20" BorderBrush="{ThemeResource PlayerChromeStrokeBrush}"
                    BorderThickness="1">
                <StackPanel HorizontalAlignment="Center" Spacing="12">
                    <Border Width="72" Height="72" CornerRadius="36"
                            Background="{ThemeResource PlayerChromeButtonBrush}">
                        <FontIcon Glyph="&#xE8B7;" FontSize="32"
                                  FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                  Foreground="{ThemeResource PlayerChromeSecondaryTextBrush}" />
                    </Border>
                    <TextBlock Text="打开媒体，开始播放" FontSize="22" FontWeight="SemiBold"
                               Foreground="{ThemeResource PlayerChromeTextBrush}"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="可多选文件，也可以把文件或文件夹拖到窗口中"
                               Foreground="{ThemeResource PlayerChromeTertiaryTextBrush}"
                               TextAlignment="Center" TextWrapping="Wrap" MaxWidth="340" />
                    <Button Content="选择媒体文件" Margin="0,8,0,0" HorizontalAlignment="Stretch"
                            Style="{StaticResource AccentButtonStyle}"
                            Command="{x:Bind ViewModel.OpenFileCommand}"
                            AutomationProperties.Name="选择媒体文件" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Width="88" Height="88" CornerRadius="44"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="#8A111318" BorderBrush="{ThemeResource PlayerChromeStrokeBrush}"
                BorderThickness="1" IsHitTestVisible="False"
                Visibility="{x:Bind ViewModel.PausedOverlayVisibility, Mode=OneWay}">
            <FontIcon Glyph="&#xE768;" FontSize="40"
                      FontFamily="{ThemeResource SymbolThemeFontFamily}"
                      Foreground="{ThemeResource PlayerChromeTextBrush}"
                      Margin="7,0,0,0" HorizontalAlignment="Center"
                      VerticalAlignment="Center" />
        </Border>

        <Border x:Name="SubtitleOverlay"
                HorizontalAlignment="Center" VerticalAlignment="Bottom"
                Margin="80,0,80,132" Padding="14,6" CornerRadius="6"
                Background="Transparent" BorderBrush="{ThemeResource PlayerChromeStrokeBrush}"
                BorderThickness="0" IsHitTestVisible="False"
                Visibility="{x:Bind ViewModel.SubtitleVisibility, Mode=OneWay}">
            <TextBlock x:Name="SubtitleTextBlock"
                       Text="{x:Bind ViewModel.SubtitleText, Mode=OneWay}"
                       Foreground="{ThemeResource PlayerChromeTextBrush}" FontSize="24" TextAlignment="Center"
                       TextWrapping="Wrap" MaxWidth="1000" />
        </Border>

        <!-- 悬浮控制层通过 BackdropBlurBrush 采样视频画布。 -->
        <Border x:Name="TopBar" Height="52" VerticalAlignment="Top" Padding="14,0"
                BorderBrush="{ThemeResource PlayerChromeStrokeBrush}"
                BorderThickness="0,0,0,1">
            <Border.Background>
                <effects:BackdropBlurBrush BlurAmount="26" TintColor="#181A20"
                                           TintOpacity="0.35" FallbackColor="#E0181A20" />
            </Border.Background>
            <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto,138">
                <Image x:Name="AppLogo" Grid.Column="0" Source="/images/player.png"
                       Margin="0,0,12,0" Width="30" Height="30" />
                <Button Grid.Column="1" Style="{StaticResource PlayerIconButtonStyle}"
                        Command="{x:Bind ViewModel.ToggleFoldersCommand}"
                        ToolTipService.ToolTip="媒体文件夹"
                        AutomationProperties.Name="显示或隐藏媒体文件夹">
                    <FontIcon Glyph="&#xE9A4;" FontSize="16"
                              FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                </Button>
                <Button Grid.Column="2" Style="{StaticResource PlayerIconButtonStyle}"
                        Margin="8,0,0,0" Command="{x:Bind ViewModel.SettingsCommand}"
                        ToolTipService.ToolTip="播放器选项"
                        AutomationProperties.Name="打开播放器选项">
                    <FontIcon Glyph="&#xE713;" FontSize="16"
                              FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                </Button>
                <StackPanel x:Name="TopTitle" Grid.Column="3" Margin="16,0"
                            VerticalAlignment="Center" Spacing="1">
                    <TextBlock Text="正在播放" FontSize="10"
                               Foreground="{ThemeResource PlayerChromeTertiaryTextBrush}" />
                    <TextBlock Text="{x:Bind ViewModel.Title, Mode=OneWay}"
                               Foreground="{ThemeResource PlayerChromeTextBrush}"
                               FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Button Grid.Column="4" Style="{StaticResource PlayerIconButtonStyle}"
                        ToolTipService.ToolTip="播放列表"
                        Command="{x:Bind ViewModel.TogglePlaylistCommand}"
                        AutomationProperties.Name="显示或隐藏播放列表">
                    <FontIcon Glyph="&#xE8FD;" FontSize="16"
                              FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                </Button>
                <Button Grid.Column="5" Style="{StaticResource PlayerIconButtonStyle}"
                        Margin="8,0,0,0" ToolTipService.ToolTip="切换全屏"
                        Command="{x:Bind ViewModel.FullScreenCommand}"
                        AutomationProperties.Name="切换全屏">
                    <FontIcon Glyph="&#xE740;" FontSize="16"
                              FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                </Button>
            </Grid>
        </Border>

        <!-- 文件夹根节点会持久化保存，展开节点时再延迟加载其子节点。 -->
        <Border x:Name="LeftSidebar" Width="286"
                HorizontalAlignment="Left" Margin="0,52,0,112" Padding="12,14,12,10"
                CornerRadius="0,14,14,0"
                BorderBrush="{ThemeResource PlayerChromeStrokeBrush}"
                BorderThickness="0,1,1,1">
            <Border.Background>
                <effects:BackdropBlurBrush BlurAmount="30" TintColor="#1A1D24"
                                           TintOpacity="0.42" FallbackColor="#E01A1D24" />
            </Border.Background>
            <Grid RowDefinitions="Auto,*,Auto">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="2,0,4,12">
                    <Border Width="34" Height="34" CornerRadius="9"
                            Background="{ThemeResource PlayerChromeButtonBrush}">
                        <FontIcon Glyph="&#xE8B7;" FontSize="16"
                                  FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                  Foreground="{ThemeResource PlayerChromeSecondaryTextBrush}" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="媒体文件夹" Style="{StaticResource SidebarTitleStyle}" />
                        <TextBlock Text="双击文件夹加载媒体" FontSize="11"
                                   Foreground="{ThemeResource PlayerChromeTertiaryTextBrush}" />
                    </StackPanel>
                    <Button Grid.Column="2" Style="{StaticResource PlayerIconButtonStyle}"
                            Width="32" Height="32" Padding="0" Margin="0,0,6,0"
                            Click="ClearFoldersButton_Click"
                            ToolTipService.ToolTip="清空媒体文件夹列表"
                            AutomationProperties.Name="清空媒体文件夹列表">
                        <FontIcon Glyph="&#xE74D;" FontSize="14"
                                  FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                    </Button>
                    <Border Grid.Column="3" MinWidth="30" Height="24" Padding="8,0"
                            CornerRadius="12" Background="{ThemeResource PlayerChromeButtonBrush}"
                            VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind ViewModel.Folders.Count, Mode=OneWay}"
                                   Foreground="{ThemeResource PlayerChromeSecondaryTextBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Grid>
                <TreeView x:Name="FolderTree" Grid.Row="1"
                          Background="Transparent"
                          Expanding="FolderTree_Expanding"
                          DoubleTapped="FolderTree_DoubleTapped">
                    <TreeView.Resources>
                        <Style TargetType="TreeViewItem">
                            <Setter Property="MinHeight" Value="36" />
                            <Setter Property="CornerRadius" Value="8" />
                            <Setter Property="Foreground" Value="{ThemeResource PlayerChromeTextBrush}" />
                        </Style>
                    </TreeView.Resources>
                    <TreeView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="4,7" ColumnDefinitions="Auto,*">
                                <FontIcon Glyph="&#xE8B7;" FontSize="14"
                                          FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                          Foreground="{ThemeResource PlayerChromeSecondaryTextBrush}" />
                                <TextBlock Grid.Column="1" Text="{Binding Content.Name}" Margin="10,0,0,0"
                                           ToolTipService.ToolTip="{Binding Content.Path}"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{ThemeResource PlayerChromeTextBrush}" />
                            </Grid>
                        </DataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
                <TextBlock Grid.Row="2" Text="支持拖入文件夹；展开节点时按需加载"
                           Margin="6,10,4,0" FontSize="11"
                           Foreground="{ThemeResource PlayerChromeTertiaryTextBrush}"
                           TextTrimming="CharacterEllipsis" />
            </Grid>
        </Border>

        <!-- 播放列表与左侧文件夹树分别独立持久化。 -->
        <Border x:Name="RightSidebar" Width="320"
                HorizontalAlignment="Right" Margin="0,52,0,112" Padding="12,14,12,10"
                CornerRadius="14,0,0,14"
                BorderBrush="{ThemeResource PlayerChromeStrokeBrush}"
                BorderThickness="1,1,0,1">
            <Border.Background>
                <effects:BackdropBlurBrush BlurAmount="30" TintColor="#1A1D24"
                                           TintOpacity="0.42" FallbackColor="#E01A1D24" />
            </Border.Background>
            <Grid RowDefinitions="Auto,*,Auto">
                <Grid Margin="4,0,4,12" ColumnDefinitions="Auto,*,Auto,Auto">
                    <Border Width="34" Height="34" CornerRadius="9"
                            Background="{ThemeResource PlayerChromeButtonBrush}">
                        <FontIcon Glyph="&#xE8FD;" FontSize="16"
                                  FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                  Foreground="{ThemeResource PlayerChromeSecondaryTextBrush}" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="播放列表" Style="{StaticResource SidebarTitleStyle}" />
                        <TextBlock Text="选择一项开始播放" FontSize="11"
                                   Foreground="{ThemeResource PlayerChromeTertiaryTextBrush}" />
                    </StackPanel>
                    <Button Grid.Column="2" Style="{StaticResource PlayerIconButtonStyle}"
                            Width="32" Height="32" Padding="0" Margin="0,0,6,0"
                            Click="ClearPlaylistButton_Click"
                            ToolTipService.ToolTip="清空播放列表"
                            AutomationProperties.Name="清空播放列表">
                        <FontIcon Glyph="&#xE74D;" FontSize="14"
                                  FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                    </Button>
                    <Border Grid.Column="3" MinWidth="30" Height="24" Padding="8,0"
                            CornerRadius="12" Background="{ThemeResource PlayerChromeButtonBrush}"
                            VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind ViewModel.Playlist.Count, Mode=OneWay}"
                                   Foreground="{ThemeResource PlayerChromeSecondaryTextBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Grid>
                <ListView x:Name="PlaylistList" Grid.Row="1" ItemsSource="{x:Bind ViewModel.Playlist}"
                          SelectedItem="{x:Bind ViewModel.SelectedItem, Mode=TwoWay}"
                          SelectionMode="Single" Background="Transparent"
                          RightTapped="Playlist_RightTapped">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,2" />
                            <Setter Property="CornerRadius" Value="9" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:PlaylistItem">
                            <Grid Padding="10,9" ColumnDefinitions="Auto,*">
                                <Border Width="30" Height="30" CornerRadius="15"
                                        Background="{ThemeResource PlayerChromeButtonBrush}">
                                    <Grid>
                                        <FontIcon Glyph="&#xE768;" FontSize="12"
                                                  FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                                  Foreground="{ThemeResource PlayerChromeSecondaryTextBrush}"
                                                  Margin="2,0,0,0" />
                                        <FontIcon Glyph="&#xE81C;" FontSize="9"
                                                  HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                  Margin="0,0,1,1"
                                                  Visibility="{x:Bind HistoryVisibility, Mode=OneWay}"
                                                  Foreground="{ThemeResource SystemAccentColor}"
                                                  FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0" Spacing="2">
                                    <TextBlock Text="{x:Bind Name}"
                                               Foreground="{ThemeResource PlayerChromeTextBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind Path}" FontSize="11"
                                               Foreground="{ThemeResource PlayerChromeTertiaryTextBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{x:Bind HistoryText, Mode=OneWay}" FontSize="11"
                                               Visibility="{x:Bind HistoryVisibility, Mode=OneWay}"
                                               Foreground="{ThemeResource SystemAccentColor}"
                                               TextTrimming="CharacterEllipsis" />
                                    <ProgressBar Height="2" Minimum="0" Maximum="100"
                                                 Value="{x:Bind HistoryProgress, Mode=OneWay}"
                                                 Visibility="{x:Bind HistoryVisibility, Mode=OneWay}"
                                                 Foreground="{ThemeResource SystemAccentColor}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <TextBlock Grid.Row="2" Text="拖入媒体文件可添加到列表顶部"
                           Margin="6,10,4,0" FontSize="11"
                           Foreground="{ThemeResource PlayerChromeTertiaryTextBrush}"
                           TextTrimming="CharacterEllipsis" />
            </Grid>
        </Border>

        <!-- 调整块跟随对应侧栏移动，并在侧栏隐藏时一同消失。 -->
        <Border x:Name="LeftSidebarHandle" Tag="Left"
                Width="14" Height="64" HorizontalAlignment="Left" VerticalAlignment="Center"
                Margin="0,52,0,112"
                Visibility="Collapsed"
                Background="{ThemeResource PlayerChromeHandleBrush}"
                BorderBrush="{ThemeResource PlayerChromeStrokeBrush}" BorderThickness="0,1,1,1"
                CornerRadius="0,7,7,0" Canvas.ZIndex="30"
                PointerPressed="SidebarHandle_PointerPressed"
                PointerMoved="SidebarHandle_PointerMoved"
                PointerReleased="SidebarHandle_PointerReleased"
                PointerCaptureLost="SidebarHandle_PointerCaptureLost"
                PointerEntered="SidebarHandle_PointerEntered"
                PointerExited="SidebarHandle_PointerExited"
                ToolTipService.ToolTip="拖动调整左侧栏；单击打开或关闭">
            <StackPanel Orientation="Horizontal" Spacing="2" Opacity="0.5"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border Width="1" Height="24" CornerRadius="0.5" Background="{ThemeResource PlayerChromeSecondaryTextBrush}" />
                <Border Width="1" Height="24" CornerRadius="0.5" Background="{ThemeResource PlayerChromeSecondaryTextBrush}" />
                <Border Width="1" Height="24" CornerRadius="0.5" Background="{ThemeResource PlayerChromeSecondaryTextBrush}" />
            </StackPanel>
        </Border>

        <Border x:Name="RightSidebarHandle" Tag="Right"
                Width="14" Height="64" HorizontalAlignment="Right" VerticalAlignment="Center"
                Margin="0,52,0,112"
                Visibility="Collapsed"
                Background="{ThemeResource PlayerChromeHandleBrush}"
                BorderBrush="{ThemeResource PlayerChromeStrokeBrush}" BorderThickness="1,1,0,1"
                CornerRadius="7,0,0,7" Canvas.ZIndex="30"
                PointerPressed="SidebarHandle_PointerPressed"
                PointerMoved="SidebarHandle_PointerMoved"
                PointerReleased="SidebarHandle_PointerReleased"
                PointerCaptureLost="SidebarHandle_PointerCaptureLost"
                PointerEntered="SidebarHandle_PointerEntered"
                PointerExited="SidebarHandle_PointerExited"
                ToolTipService.ToolTip="拖动调整右侧栏；单击打开或关闭">
            <StackPanel Orientation="Horizontal" Spacing="2" Opacity="0.5"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border Width="1" Height="24" CornerRadius="0.5" Background="{ThemeResource PlayerChromeSecondaryTextBrush}" />
                <Border Width="1" Height="24" CornerRadius="0.5" Background="{ThemeResource PlayerChromeSecondaryTextBrush}" />
                <Border Width="1" Height="24" CornerRadius="0.5" Background="{ThemeResource PlayerChromeSecondaryTextBrush}" />
            </StackPanel>
        </Border>

        <!-- 片头、片尾标记与播放进度条使用同一坐标空间。 -->
        <Border x:Name="ControlBar" Height="112" VerticalAlignment="Bottom" Padding="18,4,18,10"
                BorderBrush="{ThemeResource PlayerChromeStrokeBrush}"
                BorderThickness="0,1,0,0">
            <Border.Background>
                <effects:BackdropBlurBrush BlurAmount="32" TintColor="#15171C"
                                           TintOpacity="0.46" FallbackColor="#DE15171C" />
            </Border.Background>
            <Grid RowDefinitions="Auto,*">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <TextBlock Text="{x:Bind ViewModel.CurrentTime, Mode=OneWay}"
                               VerticalAlignment="Center" HorizontalAlignment="Center"
                               Foreground="{ThemeResource PlayerChromeSecondaryTextBrush}"
                               FontFamily="Consolas" FontSize="13" Width="48" />
                    <Slider x:Name="PositionSlider" Grid.Column="1" Margin="12,5,12,0"
                            Minimum="0" Maximum="{x:Bind ViewModel.Duration, Mode=OneWay}"
                            Value="{x:Bind ViewModel.Position, Mode=TwoWay}" VerticalAlignment="Center"
                            Foreground="{ThemeResource PlayerProgressBrush}"
                            PointerPressed="PositionSlider_PointerPressed"
                            PointerReleased="PositionSlider_PointerReleased">
                        <Slider.Resources>
                            <x:Double x:Key="SliderTrackThemeHeight">2.5</x:Double>
                            <StaticResource x:Key="SliderTrackValueFill" ResourceKey="PlayerProgressBrush" />
                            <StaticResource x:Key="SliderTrackValueFillPointerOver" ResourceKey="PlayerProgressBrush" />
                            <StaticResource x:Key="SliderTrackValueFillPressed" ResourceKey="PlayerProgressBrush" />
                            <StaticResource x:Key="SliderThumbBackground" ResourceKey="PlayerProgressBrush" />
                            <StaticResource x:Key="SliderThumbBackgroundPointerOver" ResourceKey="PlayerProgressBrush" />
                            <StaticResource x:Key="SliderThumbBackgroundPressed" ResourceKey="PlayerProgressBrush" />
                        </Slider.Resources>
                    </Slider>
                    <Border x:Name="IntroMarker" Grid.Column="1" Width="13" Height="13"
                            HorizontalAlignment="Left" Background="{ThemeResource PlayerChromeTextBrush}" CornerRadius="7"
                            Visibility="Collapsed" ToolTipService.ToolTip="设置片头"
                            PointerPressed="SkipMarker_PointerPressed"
                            PointerMoved="SkipMarker_PointerMoved" 
                            PointerReleased="SkipMarker_PointerReleased">
                        <Border x:Name="IntroCenter" PointerEntered="Border_PointerEntered" PointerExited="Border_PointerExited"
                            Width="8" Height="8" CornerRadius="4" Background="{ThemeResource PlayerMarkerBrush}" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                        </Border>
                    </Border>
                    <Border x:Name="OutroMarker" Grid.Column="1" Width="13" Height="13"
                            HorizontalAlignment="Left" Background="{ThemeResource PlayerChromeTextBrush}" CornerRadius="7"
                            Visibility="Collapsed" ToolTipService.ToolTip="设置片尾"
                            PointerPressed="SkipMarker_PointerPressed"
                            PointerMoved="SkipMarker_PointerMoved" 
                            PointerReleased="SkipMarker_PointerReleased">
                        <Border x:Name="OutroCenter" PointerEntered="Border_PointerEntered" PointerExited="Border_PointerExited"
                                Width="8" Height="8" CornerRadius="4" Background="{ThemeResource PlayerProgressBrush}" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                        </Border>
                    </Border>
                    <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.DurationText, Mode=OneWay}"
                               VerticalAlignment="Center"
                               Foreground="{ThemeResource PlayerChromeSecondaryTextBrush}"
                               FontFamily="Consolas" FontSize="13" MinWidth="48" TextAlignment="Right" />
                </Grid>

                <Grid Grid.Row="1" ColumnDefinitions="*,Auto,*">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left"
                                VerticalAlignment="Center" Spacing="6">
                        <ToggleButton x:Name="KeepControlBarToggle"
                                      Style="{StaticResource PlayerToggleButtonStyle}"
                                      Click="KeepControlBarToggle_Click"
                                      ToolTipService.ToolTip="自动隐藏或固定显示"
                                      AutomationProperties.Name="切换底部控制栏显示方式">
                            <FontIcon Glyph="&#xE840;" FontSize="16"
                                      FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                        </ToggleButton>
                        <Button x:Name="IntroActionButton" Style="{StaticResource PlayerIconButtonStyle}"
                                Command="{x:Bind ViewModel.SetIntroMarkerCommand}"
                                ToolTipService.ToolTip="设置或清除片头"
                                AutomationProperties.Name="设置或清除片头">
                            <FontIcon Glyph="&#xE7B7;" Foreground="{ThemeResource PlayerMarkerBrush}"
                                      FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="16" />
                        </Button>
                        <Button x:Name="OutroActionButton" Style="{StaticResource PlayerIconButtonStyle}"
                                Command="{x:Bind ViewModel.SetOutroMarkerCommand}"
                                ToolTipService.ToolTip="设置或清除片尾"
                                AutomationProperties.Name="设置或清除片尾">
                            <FontIcon Glyph="&#xEC72;" Foreground="{ThemeResource PlayerProgressBrush}"
                                      FontFamily="{ThemeResource SymbolThemeFontFamily}" FontSize="16" />
                        </Button>
                        <Button Style="{StaticResource PlayerIconButtonStyle}"
                                Command="{x:Bind ViewModel.OpenFileCommand}"
                                ToolTipService.ToolTip="打开媒体文件"
                                AutomationProperties.Name="打开媒体文件">
                            <FontIcon Glyph="&#xE8E5;" FontSize="16"
                                      FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                        </Button>

                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                        <Button Style="{StaticResource PlayerIconButtonStyle}"
                                Command="{x:Bind ViewModel.PreviousCommand}"
                                ToolTipService.ToolTip="上一项"
                                AutomationProperties.Name="播放上一项">
                            <FontIcon Glyph="&#xE892;" FontSize="16"
                                      FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                        </Button>
                        <Button Style="{StaticResource PlayerIconButtonStyle}"
                                Command="{x:Bind ViewModel.BackCommand}"
                                ToolTipService.ToolTip="后退"
                                AutomationProperties.Name="后退">
                            <FontIcon Glyph="&#xE76B;" FontSize="16"
                                      FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                        </Button>
                        <Button Width="54" Height="54" CornerRadius="27" Padding="0"
                                Background="{ThemeResource PlayerChromeTextBrush}"
                                BorderBrush="{ThemeResource PlayerChromeStrokeBrush}"
                                BorderThickness="1"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                Command="{x:Bind ViewModel.PlayPauseCommand}"
                                ToolTipService.ToolTip="播放或暂停"
                                AutomationProperties.Name="播放或暂停">
                            <FontIcon Glyph="{x:Bind ViewModel.PlayPauseGlyph, Mode=OneWay}"
                                      FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                      FontSize="22" Foreground="{ThemeResource PlayerPrimaryButtonGlyphBrush}"
                                      Margin="2,0,0,0" />
                        </Button>
                        <Button Style="{StaticResource PlayerIconButtonStyle}"
                                Command="{x:Bind ViewModel.ForwardCommand}"
                                ToolTipService.ToolTip="前进"
                                AutomationProperties.Name="前进">
                            <FontIcon Glyph="&#xE76C;" FontSize="16"
                                      FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                        </Button>
                        <Button Style="{StaticResource PlayerIconButtonStyle}"
                                Command="{x:Bind ViewModel.NextCommand}"
                                ToolTipService.ToolTip="下一项"
                                AutomationProperties.Name="播放下一项">
                            <FontIcon Glyph="&#xE893;" FontSize="16"
                                      FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                        </Button>
                        <Button Style="{StaticResource PlayerIconButtonStyle}"
                                Command="{x:Bind ViewModel.StopPlaybackCommand}"
                                ToolTipService.ToolTip="停止并关闭"
                                AutomationProperties.Name="停止并关闭">
                            <FontIcon Glyph="&#xE71A;" FontSize="14"
                                      FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                        </Button>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right"
                                VerticalAlignment="Center" Spacing="6">
                        <Button x:Name="SubtitleTrackButton" Style="{StaticResource PlayerIconButtonStyle}"
                                ToolTipService.ToolTip="字幕轨道"
                                AutomationProperties.Name="选择字幕轨道">
                            <Button.Flyout>
                                <MenuFlyout Opening="SubtitleMenuFlyout_Opening" />
                            </Button.Flyout>
                            <FontIcon Glyph="&#xED1E;" FontSize="16"
                                      FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                        </Button>
                        <Button x:Name="AudioTrackButton" Style="{StaticResource PlayerIconButtonStyle}"
                                ToolTipService.ToolTip="音频轨道"
                                AutomationProperties.Name="选择音频轨道">
                            <Button.Flyout>
                                <MenuFlyout Opening="AudioMenuFlyout_Opening" />
                            </Button.Flyout>
                            <FontIcon Glyph="&#xED1F;" FontSize="16"
                                      FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                        </Button>
                        <Button Style="{StaticResource PlayerIconButtonStyle}"
                                Command="{x:Bind ViewModel.ToggleMuteCommand}"
                                ToolTipService.ToolTip="静音或恢复音量"
                                AutomationProperties.Name="静音或恢复音量">
                            <FontIcon Glyph="{x:Bind ViewModel.VolumeGlyph, Mode=OneWay}"
                                      FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                        </Button>
                        <Slider x:Name="VolumeSlider" Width="108" Minimum="0" Maximum="100"
                                VerticalAlignment="Center"
                                ValueChanged="VolumeSlider_ValueChanged"
                                Value="{x:Bind ViewModel.Volume, Mode=TwoWay}"
                                AutomationProperties.Name="播放音量" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
        <!-- 加载状态独立于短时操作消息，多个异步加载叠加时不会被提前关闭。 -->
        <Border HorizontalAlignment="Center" VerticalAlignment="Top"
                Margin="24,5,24,0" MaxWidth="680" Padding="16,10"
                Visibility="{x:Bind ViewModel.LoadingVisibility, Mode=OneWay}"
                IsHitTestVisible="False" CornerRadius="8" Canvas.ZIndex="41">
            <Border.Background>
                <effects:BackdropBlurBrush BlurAmount="28" TintColor="#181A20"
                                           TintOpacity="0.38" FallbackColor="#E0181A20" />
            </Border.Background>
            <StackPanel Orientation="Horizontal" Spacing="10">
                <ProgressRing Width="18" Height="18" IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                              Foreground="{ThemeResource SystemAccentColor}" />
                <TextBlock Text="{x:Bind ViewModel.LoadingMessage, Mode=OneWay}"
                           VerticalAlignment="Center"
                           Foreground="{ThemeResource PlayerChromeTextBrush}" />
            </StackPanel>
        </Border>

        <!-- InfoBar 各消息级别的背景保持透明，由此容器提供视频毛玻璃效果。 -->
        <Border x:Name="OperationInfoBarHost"
                HorizontalAlignment="Center" VerticalAlignment="Top"
                Margin="24,5,24,0" MaxWidth="680"
                Visibility="Collapsed" IsHitTestVisible="False"
                BorderThickness="0" CornerRadius="8" Canvas.ZIndex="42">
            <Border.Background>
                <effects:BackdropBlurBrush BlurAmount="28"
                                   TintColor="#181A20"
                                   TintOpacity="0.38"
                                   FallbackColor="#E0181A20"/>
            </Border.Background>
            <InfoBar x:Name="OperationInfoBar"
                     IsOpen="False" IsClosable="False"
                     Background="Transparent" BorderThickness="0"
                     CornerRadius="8">
                <InfoBar.Resources>
                    <!-- 清除 InfoBar 严重级别状态的默认不透明背景，保留毛玻璃效果。 -->
                    <SolidColorBrush x:Key="InfoBarInformationalSeverityBackgroundBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="InfoBarSuccessSeverityBackgroundBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="InfoBarWarningSeverityBackgroundBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="InfoBarErrorSeverityBackgroundBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="InfoBarTitleForeground" Color="White" />
                    <SolidColorBrush x:Key="InfoBarMessageForeground" Color="White" />
                </InfoBar.Resources>
            </InfoBar>
        </Border>
    </Grid>
</Window>
