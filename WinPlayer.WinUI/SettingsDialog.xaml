<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="WinPlayer.WinUI.SettingsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    Title="播放器选项"
    PrimaryButtonText="保存更改"
    CloseButtonText="取消"
    DefaultButton="Primary"
    MinWidth="820"
    CornerRadius="10"
    MaxWidth="920">

    <ContentDialog.Resources>
        <!-- ContentDialog 默认宽度偏窄，设置页需要容纳导航与说明文字。 -->
        <x:Double x:Key="ContentDialogMinWidth">820</x:Double>
        <x:Double x:Key="ContentDialogMaxWidth">920</x:Double>

        <Style x:Key="SettingsNumberBoxStyle" TargetType="NumberBox">
            <Setter Property="Width" Value="150" />
            <Setter Property="SpinButtonPlacementMode" Value="Compact" />
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="Margin" Value="4,12,4,2" />
        </Style>
    </ContentDialog.Resources>

    <Grid Width="820" Height="540">
        <NavigationView x:Name="SettingsNavigation"
                        PaneDisplayMode="Left"
                        OpenPaneLength="178"
                        CompactPaneLength="48"
                        IsPaneOpen="True"
                        IsPaneToggleButtonVisible="False"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="False"
                        SelectionChanged="SettingsNavigation_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="PlaybackNavigationItem"
                                    Content="播放" Tag="Playback"
                                    AutomationProperties.Name="播放设置">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE768;" FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="界面" Tag="Appearance"
                                    AutomationProperties.Name="界面设置">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE790;" FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="记录与启动" Tag="History"
                                    AutomationProperties.Name="记录与启动设置">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE81C;" FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="诊断日志" Tag="Diagnostics"
                                    AutomationProperties.Name="诊断日志">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9D9;" FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Grid Padding="24,8,18,18">
                <ScrollViewer x:Name="PlaybackSection"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="8" Padding="0,0,10,20">
                        <TextBlock Text="播放" FontSize="24" FontWeight="SemiBold" />
                        <TextBlock Text="控制媒体打开方式、音量过渡和跳转行为。"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" Margin="0,0,0,8" />

                        <TextBlock Text="打开媒体" Style="{StaticResource SectionTitleStyle}" />
                        <controls:SettingsCard Header="自动播放"
                                               Description="打开媒体或恢复上次会话后立即开始播放">
                            <ToggleSwitch x:Name="AutoPlayToggle" OnContent="开" OffContent="关"
                                          AutomationProperties.Name="自动播放" />
                        </controls:SettingsCard>
                        <controls:SettingsCard Header="自动进入全屏"
                                               Description="媒体成功打开后切换到全屏播放">
                            <ToggleSwitch x:Name="AutoFullScreenToggle" OnContent="开" OffContent="关"
                                          AutomationProperties.Name="自动进入全屏" />
                        </controls:SettingsCard>
                        <controls:SettingsCard Header="默认音量"
                                               Description="程序启动和恢复会话时使用的音量">
                            <NumberBox x:Name="VolumeNumber" Minimum="0" Maximum="100"
                                       SmallChange="1" Style="{StaticResource SettingsNumberBoxStyle}"
                                       AutomationProperties.Name="默认音量" />
                        </controls:SettingsCard>

                        <TextBlock Text="播放过渡" Style="{StaticResource SectionTitleStyle}" />
                        <controls:SettingsCard Header="新媒体音量渐入"
                                               Description="切换文件时从静音平滑恢复到目标音量">
                            <ToggleSwitch x:Name="VolumeFadeToggle" OnContent="开" OffContent="关"
                                          AutomationProperties.Name="新媒体音量渐入" />
                        </controls:SettingsCard>
                        <controls:SettingsCard Header="渐入时间"
                                               Description="音量恢复到目标值所需的秒数">
                            <NumberBox x:Name="VolumeFadeDurationNumber" Minimum="0.1" Maximum="10"
                                       SmallChange="0.1" Style="{StaticResource SettingsNumberBoxStyle}"
                                       AutomationProperties.Name="音量渐入时间（秒）" />
                        </controls:SettingsCard>

                        <TextBlock Text="跳转" Style="{StaticResource SectionTitleStyle}" />
                        <controls:SettingsCard Header="快进/快退间隔"
                                               Description="方向键每次跳转的秒数">
                            <NumberBox x:Name="SeekSecondsNumber" Minimum="1" Maximum="300"
                                       SmallChange="1" Style="{StaticResource SettingsNumberBoxStyle}"
                                       AutomationProperties.Name="快进快退间隔（秒）" />
                        </controls:SettingsCard>
                        <controls:SettingsCard Header="片头结束位置"
                                               Description="从文件开头自动跳过的秒数；0 表示关闭">
                            <NumberBox x:Name="SkipIntroNumber" Minimum="0" Maximum="3600"
                                       SmallChange="1" Style="{StaticResource SettingsNumberBoxStyle}"
                                       AutomationProperties.Name="片头结束位置（秒）" />
                        </controls:SettingsCard>
                        <controls:SettingsCard Header="片尾提前跳过"
                                               Description="距离文件结尾多少秒时播放下一项；0 表示关闭">
                            <NumberBox x:Name="SkipOutroNumber" Minimum="0" Maximum="3600"
                                       SmallChange="1" Style="{StaticResource SettingsNumberBoxStyle}"
                                       AutomationProperties.Name="片尾提前跳过（秒）" />
                        </controls:SettingsCard>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="AppearanceSection" Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="8" Padding="0,0,10,20">
                        <TextBlock Text="界面" FontSize="24" FontWeight="SemiBold" />
                        <TextBlock Text="调整控制栏行为、侧栏尺寸和播放画面上的毛玻璃层。"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" Margin="0,0,0,8" />

                        <TextBlock Text="控制栏" Style="{StaticResource SectionTitleStyle}" />
                        <controls:SettingsCard Header="底部控制栏一直显示"
                                               Description="关闭后，鼠标移出控制区域会延时自动隐藏">
                            <ToggleSwitch x:Name="KeepControlBarToggle" OnContent="固定" OffContent="自动"
                                          AutomationProperties.Name="底部控制栏显示方式" />
                        </controls:SettingsCard>
                        <controls:SettingsCard Header="自动隐藏延迟"
                                               Description="鼠标移出后等待多少秒隐藏控制栏">
                            <NumberBox x:Name="AutoHideDelayNumber" Minimum="0.5" Maximum="30"
                                       SmallChange="0.5" Style="{StaticResource SettingsNumberBoxStyle}"
                                       AutomationProperties.Name="控制栏自动隐藏延迟（秒）" />
                        </controls:SettingsCard>
                        <controls:SettingsCard Header="面板动画时长"
                                               Description="侧栏和控制栏滑入、滑出的毫秒数">
                            <NumberBox x:Name="AnimationDurationNumber" Minimum="100" Maximum="1500"
                                       SmallChange="50" Style="{StaticResource SettingsNumberBoxStyle}"
                                       AutomationProperties.Name="面板动画时长（毫秒）" />
                        </controls:SettingsCard>

                        <TextBlock Text="侧栏" Style="{StaticResource SectionTitleStyle}" />
                        <controls:SettingsCard Header="左侧栏宽度"
                                               Description="媒体文件夹面板的默认宽度">
                            <NumberBox x:Name="LeftSidebarWidthNumber" Minimum="180" Maximum="600"
                                       SmallChange="10" Style="{StaticResource SettingsNumberBoxStyle}"
                                       AutomationProperties.Name="左侧栏宽度" />
                        </controls:SettingsCard>
                        <controls:SettingsCard Header="右侧栏宽度"
                                               Description="播放列表面板的默认宽度">
                            <NumberBox x:Name="RightSidebarWidthNumber" Minimum="180" Maximum="600"
                                       SmallChange="10" Style="{StaticResource SettingsNumberBoxStyle}"
                                       AutomationProperties.Name="右侧栏宽度" />
                        </controls:SettingsCard>

                        <TextBlock Text="字幕" Style="{StaticResource SectionTitleStyle}" />
                        <controls:SettingsCard Header="字幕字体"
                                               Description="选择系统中已经安装的字体；缺少中文字形时系统会自动回退">
                            <ComboBox x:Name="SubtitleFontFamilyCombo"
                                      Width="240" MaxDropDownHeight="320"
                                      HorizontalAlignment="Right"
                                      AutomationProperties.Name="字幕字体" />
                        </controls:SettingsCard>
                        <controls:SettingsCard Header="字幕基准字号"
                                               Description="窗口宽度为 1200 时使用的字号；窗口缩放时会按比例调整">
                            <NumberBox x:Name="SubtitleBaseFontSizeNumber"
                                       Minimum="12" Maximum="72" SmallChange="1"
                                       Style="{StaticResource SettingsNumberBoxStyle}"
                                       AutomationProperties.Name="字幕基准字号" />
                        </controls:SettingsCard>
                        <controls:SettingsCard Header="字幕底部位置"
                                               Description="字幕与播放区域底部的距离，使用播放区域高度百分比">
                            <NumberBox x:Name="SubtitleBottomOffsetNumber"
                                       Minimum="2" Maximum="50" SmallChange="1"
                                       Style="{StaticResource SettingsNumberBoxStyle}"
                                       AutomationProperties.Name="字幕距底部百分比" />
                        </controls:SettingsCard>

                        <TextBlock Text="毛玻璃" Style="{StaticResource SectionTitleStyle}" />
                        <controls:SettingsCard Header="模糊强度"
                                               Description="悬浮面板采样播放画面后的高斯模糊程度">
                            <NumberBox x:Name="BlurAmountNumber" Minimum="0" Maximum="100"
                                       SmallChange="1" Style="{StaticResource SettingsNumberBoxStyle}"
                                       AutomationProperties.Name="毛玻璃模糊强度" />
                        </controls:SettingsCard>
                        <controls:SettingsCard Header="色调不透明度"
                                               Description="深色蒙层强度，范围为 0 到 1">
                            <NumberBox x:Name="TintOpacityNumber" Minimum="0" Maximum="1"
                                       SmallChange="0.05" Style="{StaticResource SettingsNumberBoxStyle}"
                                       AutomationProperties.Name="毛玻璃色调不透明度" />
                        </controls:SettingsCard>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="HistorySection" Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="8" Padding="0,0,10,20">
                        <TextBlock Text="记录与启动" FontSize="24" FontWeight="SemiBold" />
                        <TextBlock Text="决定程序启动方式，以及何时保存和恢复播放进度。"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" Margin="0,0,0,8" />

                        <TextBlock Text="启动" Style="{StaticResource SectionTitleStyle}" />
                        <controls:SettingsCard Header="单例运行"
                                               Description="重复启动时把文件转交给现有窗口；下次启动生效">
                            <ToggleSwitch x:Name="SingleInstanceToggle" OnContent="开" OffContent="关"
                                          AutomationProperties.Name="单例运行" />
                        </controls:SettingsCard>

                        <TextBlock Text="播放记录" Style="{StaticResource SectionTitleStyle}" />
                        <controls:SettingsCard Header="保存播放位置"
                                               Description="关闭或切换媒体时记录当前播放进度">
                            <ToggleSwitch x:Name="SavePositionToggle" OnContent="开" OffContent="关"
                                          AutomationProperties.Name="保存播放位置" />
                        </controls:SettingsCard>
                        <controls:SettingsCard Header="恢复播放位置"
                                               Description="再次打开媒体时回到上次停止的位置">
                            <ToggleSwitch x:Name="ResumePositionToggle" OnContent="开" OffContent="关"
                                          AutomationProperties.Name="恢复播放位置" />
                        </controls:SettingsCard>
                        <controls:SettingsCard Header="记录保留天数"
                                               Description="超过此期限的播放记录会被自动清理">
                            <NumberBox x:Name="HistoryRetentionNumber" Minimum="1" Maximum="3650"
                                       SmallChange="1" Style="{StaticResource SettingsNumberBoxStyle}"
                                       AutomationProperties.Name="播放记录保留天数" />
                        </controls:SettingsCard>
                        <controls:SettingsCard Header="播放记录最大数量"
                                               Description="超过上限时自动删除更新时间最早的记录；默认 2,000 条">
                            <NumberBox x:Name="MaxHistoryEntriesNumber"
                                       Minimum="100" Maximum="100000"
                                       SmallChange="100" LargeChange="1000"
                                       Style="{StaticResource SettingsNumberBoxStyle}"
                                       AutomationProperties.Name="播放记录最大数量" />
                        </controls:SettingsCard>
                    </StackPanel>
                </ScrollViewer>

                <Grid x:Name="DiagnosticsSection" Visibility="Collapsed" RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="诊断日志" FontSize="24" FontWeight="SemiBold" />
                    <TextBlock Grid.Row="1"
                               Text="显示最近 1,000 条运行日志，最新记录位于顶部。复制日志后可用于问题反馈。"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextWrapping="Wrap" />
                    <TextBox x:Name="LogTextBox" Grid.Row="2"
                             IsReadOnly="True" AcceptsReturn="True"
                             TextWrapping="NoWrap"
                             FontFamily="Consolas"
                             FontSize="12"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             AutomationProperties.Name="运行日志内容" />
                    <Grid Grid.Row="3" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Content="刷新" Click="RefreshLogButton_Click"
                                ToolTipService.ToolTip="重新读取日志文件" />
                        <Button Grid.Column="1" Content="复制" Click="CopyLogButton_Click"
                                ToolTipService.ToolTip="复制当前显示的日志" />
                        <Button Grid.Column="2" Content="打开日志目录" Click="OpenLogFolderButton_Click"
                                ToolTipService.ToolTip="在文件资源管理器中打开日志目录" />
                        <TextBlock x:Name="LogStatusText" Grid.Column="3"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </Grid>
                </Grid>
            </Grid>
        </NavigationView>
    </Grid>
</ContentDialog>
